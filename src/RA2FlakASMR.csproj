<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <OutputType>WinExe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <RootNamespace>FlakASMR</RootNamespace>
    <AssemblyName>RA2FlakASMR</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <OutputPath>..\dist\</OutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\images\flak.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" />
    <Reference Include="System.Drawing" /><Reference Include="System.Windows.Forms" />
    <Compile Include="FlakASMR.cs" /><Compile Include="WasapiEngine.cs" />
    <Compile Include="PixelForm.cs" /><Compile Include="AssemblyInfo.cs" />
    <Compile Include="PerformanceTests.cs" />
    <Compile Include="Mixer.cs" /><Compile Include="AttackSoundBus.cs" /><Compile Include="OilIncome.cs" />
    <Compile Include="Settings.cs" />
    <EmbeddedResource Include="..\assets\audio\*.wav"><LogicalName>%(Filename)%(Extension)</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\assets\images\*.png"><LogicalName>%(Filename)%(Extension)</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\assets\images\flak.ico"><LogicalName>flak.ico</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\assets\fonts\westwood.bin"><LogicalName>westwood.bin</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\assets\fonts\FONT-LICENSE.txt"><LogicalName>FONT-LICENSE.txt</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
